# Optional. Leave empty to use the public Frankfurter ECB feed (no key required).
CURRENCY_API_KEY=
CURRENCY_API_URL=https://api.frankfurter.app/latest

# Optional. Nominatim is used by default when empty.
GEOCODING_API_KEY=
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search

# Optional. Distance is calculated locally from geocoded coordinates when empty.
DISTANCE_API_KEY=
DISTANCE_API_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
